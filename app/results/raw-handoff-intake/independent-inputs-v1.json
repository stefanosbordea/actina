    },
    {
      "id": "tariff_reordered_bom_crlf",
      "action": "Select optional fifth tariff file with reordered columns/rows andBOM/CRLF.",
      "expect": "96\u219294EUR;tariff rawbytes/hashretained;reopen recomputes same association."
    },
    {
      "id": "duplicate_role",
      "action": "Add a duplicate weather CSV under a different filename.",
      "expect": "Reject duplicate role; no current result or export."
    },
    {
      "id": "missing_role",
      "action": "Select only three of the four files.",
      "expect": "Reject missing role; no current result or export."
    },
    {
      "id": "unknown_columns",
      "action": "Append daily_total column to scheduleCSV.",
      "expect": "Reject unknown role/schema; never silentlydiscardcolumn."
    },
    {
      "id": "missing_confirmation",
      "action": "Leave each required meaning/confirmation unset in turn.",
      "expect": "No comparison or export; relevant control focused."
    },
    {
      "id": "point_meaning",
      "action": "Explicitly declare point samples thenCompare.",
      "expect": "Inspectablepointpower;all energy/cost totalsunknown."
    },
    {
      "id": "tariff_partial",
      "action": "Remove one tariff row but keep schedule complete.",
      "expect": "Fullsupportcostunknown;energyknown."
    },
    {
      "id": "tariff_zero",
      "action": "Set all tariff values to0.",
      "expect": "Costnormal/aquashift/delta exact0, notunknown."
    },
    {
      "id": "tariff_literal_underflow",
      "action": "Replace one nonzero price with1e-400.",
      "expect": "Reject precision loss before it becomes0."
    },
    {
      "id": "tariff_packet_disagreement",
      "action": "Change one declaration tariff but retain correctlyhashed originaltariff_file.",
      "expect": "Reopen rejects disagreement; previousresultcleared."
    },
    {
      "id": "delayed_file_replacement",
      "action": "Delay first file hash; replace one CSV selection before completion.",
      "expect": "Old pending combination cannot create a result or enableexport."
    },
    {
      "id": "delayed_form_replacement",
      "action": "Delay compare hashing; edit offset, testperiod, power, threshold, tariff or confirmation.",
      "expect": "Anyeditinvalidates oldconfirmation/result; onlynew fullyconfirmed combination maycomplete."
    },
    {
      "id": "cached_result_tamper",
      "action": "Alter cached result and add priornote to exportedpacket.",
      "expect": "Reopen recomputes rawsources; priornote discarded."
    },
    {
      "id": "global_context_isolation",
      "action": "Openrawreview while existingforecast/plan contexts andsavedreviewnotes areselected.",
      "expect": "Those identities/selections/notes remainunchanged."
