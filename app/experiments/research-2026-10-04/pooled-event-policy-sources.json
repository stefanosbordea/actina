      "from fractions import Fraction as F\nimport json\n\ndef scores(t,k,m):\n return dict(precision=t/k if k else None,recall=t/m if m else None,f1=2*t/(k+m) if k+m else None)\n\ndef show(v):\n return {k:str(x) if x is not None else None for k,x in v.items()}\nraw1=scores(F(3,4),1,F(13,8))\npolicy1=scores(F(13,8),2,F(13,8))\nassert all(policy1[k]>raw1[k] for k in raw1)\nraw2=scores(F(83,4),21,F(173,8))\npolicy2=scores(F(173,8),22,F(173,8))\nassert policy2['precision'] < raw2['precision']\nassert max((F(13,8)+k)/(2+k) for k in range(21)) < raw2['precision']\nraw_credit=scores(F(5,4),2,F(5,2))\npolicy_credit=scores(F(9,4),3,F(5,2))\nassert all(policy_credit[k]>raw_credit[k] for k in raw_credit)\nassert F(1,2)+F(1,2)==1\nassert F(1,2)-F(1,2)==0\nassert F(3,2)/2<F(1)\nprint(json.dumps(dict(status='PASS',scope='Two hand-built exact-rational examples only. No historical inputs or candidate policies.',moving_raw_guard=dict(day_one_raw=show(raw1),day_one_policy=show(policy1),day_two_raw=show(raw2),day_two_policy=show(policy2),no_current_subset_can_restore_precision=True),cumulative_balances=dict(raw=show(raw_credit),policy=show(policy_credit),cumulative_TP_gain='1',cumulative_FP_saving='0',day_two_precision_falls=True)),indent=2))\n"
